<# Resume template. Jinja2 delimiters: << expr >>, pct tag pct, hash comment hash. All user content flows through the |tex filter. #>
% =============================================================
%  Resume template — rendered by Jinja2 + compiled by Tectonic
%  All user content flows through the |tex filter (LaTeX escape).
%  This file MUST contain only generic placeholders — no real names,
%  no real schools, no real bullets. Review before every commit.
% =============================================================
\documentclass[<< ui.page.size|default("a4paper")|tex >>,<< ui.page.font_size|default("11pt")|tex >>]{article}
\usepackage{latexsym}
\usepackage{xcolor}
\usepackage{float}
\usepackage{ragged2e}
\usepackage[empty]{fullpage}
\usepackage{wrapfig}
\usepackage{tabularx}
\usepackage{titlesec}
\usepackage{geometry}
\usepackage{marvosym}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
% fontawesome5 omitted — crashes tectonic on Windows due to OTF font loading
\usepackage{multicol}
\usepackage{graphicx}
\usepackage{cfr-lm}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\setlength{\multicolsep}{<< ui.spacing.multicolsep|default("0pt")|tex >>}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\geometry{left=<< ui.page.margin_left|default("1.4cm")|tex >>, top=<< ui.page.margin_top|default("0.8cm")|tex >>, right=<< ui.page.margin_right|default("1.2cm")|tex >>, bottom=<< ui.page.margin_bottom|default("1.0cm")|tex >>}
\usepackage[most]{tcolorbox}
\tcbset{
    frame code={},
    center title,
    left=0pt,
    right=0pt,
    top=0pt,
    bottom=0pt,
    colback=<< ui.colors.tcolorbox_bg|default("gray!20")|tex >>,
    colframe=white,
    width=\dimexpr\textwidth\relax,
    enlarge left by=-2mm,
    boxsep=4pt,
    arc=0pt,outer arc=0pt,
}

\urlstyle{same}
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
\titleformat{\section}{
  \vspace{<< ui.section_heading.vspace_before|default("-4pt")|tex >>}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{<< ui.section_heading.vspace_after|default("-7pt")|tex >>}]

%-------------------------
% Custom commands
\newcommand{\resumeItem}[2]{
  \item{
    \textbf{#1}{\hspace{0.5mm}#2 \vspace{-0.5mm}}
  }
}

\newcommand{\resumeSubheading}[4]{
\vspace{0.5mm}\item
    \begin{tabular*}{0.98\textwidth}[t]{l@{\extracolsep{\fill}}r}
        \textbf{#1} & \textit{\footnotesize{#4}} \\
        #3 &  \footnotesize{}\\
    \end{tabular*}
    \vspace{-2.4mm}
}

\newcommand{\resumeProject}[4]{
\vspace{0.5mm}\item
    \begin{tabular*}{0.98\textwidth}[t]{l@{\extracolsep{\fill}}r}
        \textbf{#1} & \textit{\footnotesize{#3}} \\
        #2 & \footnotesize{#4}
    \end{tabular*}
    \vspace{-2.4mm}
}

\renewcommand{\labelitemi}{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=*,labelsep=0mm]}
\newcommand{\resumeItemListStart}{\begin{justify}\begin{itemize}[leftmargin=3ex, rightmargin=2ex, noitemsep,labelsep=1.2mm,itemsep=0mm]\small}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}\vspace{2mm}}
\newcommand{\resumeItemListEnd}{\end{itemize}\end{justify}\vspace{-2mm}}

\newcolumntype{L}{>{\raggedright\arraybackslash}X}%
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}%
\newcolumntype{C}{>{\centering\arraybackslash}X}%

%-------------------------------------------
\begin{document}
\fontfamily{<< ui.fonts.family|default("cmr")|tex >>}\selectfont

%----------HEADING-----------------
\begin{center}
    \parbox{\dimexpr\textwidth}{
        \centering
        \textbf{\<< ui.header.name_size|default("Large")|tex >> << name|tex >>} \\[4pt]
<% if title %>        \textit{<< title|tex >>} \\[8pt]
<% endif %>
<% if contact and contact.email %>        << contact.email|tex >><% if contact.links %> \,\textbar\,
<% for link in contact.links %>        \href{<< link.url|tex >>}{<< (link.display or link.label or link.url)|tex >>}<% if not loop.last %> \,\textbar\, <% endif %>
<% endfor %>
<% endif %>
        \\[4pt]
<% endif %>
<% if contact and contact.phone %>        << contact.phone|tex >>
<% endif %>
    }
\end{center}

<# ---------- Sections ---------- #>
<# WHICH sections exist, their ORDER, their TITLES and which catalogue keys   #>
<# feed them all come from ui.sections — see render.resolve_sections, which   #>
<# supplies DEFAULT_SECTIONS when a config has none, resolves each title, and #>
<# prunes blocks the catalogue has no content for. Nothing about the section  #>
<# list is hardcoded here, so a user can add/reorder/rename/remove sections   #>
<# (even ones this template has never heard of) in config alone.              #>
<#                                                                            #>
<# Four `kind`s cover every layout:                                           #>
<#   prose    bare paragraph (the summary)                                    #>
<#   entries  bold/italic heading, right-hand date or range, optional note    #>
<#            line, then bullets                                              #>
<#   oneline  a single \item per entry                                        #>
<#   skills   one labelled line per sub-list, or a flat comma-joined line     #>
<# Field slots are filled by name via join_fields/date_range (render.py), so  #>
<# the LaTeX below never mentions a catalogue field.                          #>
<% for sec in ui.sections %>
<# A prose section is bare text; every other kind lives inside the itemize. #>
<% set boxed = sec.blocks|rejectattr("kind", "eq", "prose")|list %>
\section{\textbf{<< sec.title|tex >>}}
<% if boxed %>
\begin{itemize}[leftmargin=0.05in, label={}]
\small{
<% endif %>
<% for b in sec.blocks %>
<% set data = content.get(b.source) %>
<% set f = b.fields %>
<% if b.kind == "prose" %>
<< data|tex >>
<% elif b.kind == "skills" %>
<% if data is mapping %>
<% for label, text in skill_lines(data, ui.skill_labels) %>    \item{\textbf{<< label|tex >>}: << text|tex >>}
<% endfor %>
<% else %>
    \item{<< data|map("tex")|join(", ") >>}
<% endif %>
<% elif b.kind == "oneline" %>
<% for it in data %>
<% set rest = join_fields(it, f.rest) %>
<% set paren = join_fields(it, [f.paren]) if f.paren else "" %>
    \item{\textbf{<< join_fields(it, f.bold)|tex >>}<% if rest %><< f.sep|tex >><< rest|tex >><% endif %><% if paren %> (<< paren|tex >>)<% endif %>}
<% endfor %>
<% else %>
<# kind == "entries" (the default). SectionBlock.kind is a Literal, so the #>
<# four branches here are exhaustive.                                      #>
<% for it in data %>
<% set ital = join_fields(it, f.italic) %>
<% set right = date_range(it, f.right) %>
<% set note = join_fields(it, [f.note]) if f.note else "" %>
    \item{
        \begin{tabular*}{0.98\textwidth}{l@{\extracolsep{\fill}}r}
<# +%> keeps the newline trim_blocks would otherwise eat after the endif. #>
        \textbf{<< join_fields(it, f.bold)|tex >>}<% if ital %><< f.italic_sep|tex >>\textit{<< ital|tex >>}<% endif %> &<% if right %> \textit{<< right|tex >>}<% endif +%>
        \end{tabular*}\\
<% if note %>        << f.note_label|tex >>: << note|tex >>
<% endif %>
<% if it.get(f.bullets) %>        \resumeItemListStart
<% for h in it.get(f.bullets) %>            \item << h.text|tex >>
<% endfor %>        \resumeItemListEnd
<% endif %>
    }
<% endfor %>
<% endif %>
<% endfor %>
<% if boxed %>
}
\end{itemize}
<% endif %>
\vspace{<< sec.space_after|tex >>}

<% endfor %>
\end{document}
