{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__resume__generate_resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/pre_generate_no_emdash.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__resume__generate_resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/post_generate_reminder.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/post_generate_guidelines_reminder.py\""
          }
        ]
      },
      {
        "matcher": "mcp__resume__get_interview_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/post_interview_reminder.py\""
          }
        ]
      },
      {
        "matcher": "mcp__resume__search_platsbanken",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/post_search_qualification_reminder.py\""
          }
        ]
      }
    ]
  }
}
